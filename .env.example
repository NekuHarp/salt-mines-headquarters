# Base URL of the salt-mines API. Must be VITE_-prefixed to reach client code.
VITE_SALT_MINES_BACKEND_URL=http://localhost:3000

# The API's Basic Auth credentials are deliberately absent: anything in this
# file is inlined into the production bundle and readable by anyone who loads
# the page. They are entered through the app's login screen instead and kept in
# sessionStorage for the tab's lifetime.
#
# The backend must also allow this app's origin — set CORS_ALLOWED_ORIGINS in
# the salt-mines .env (it defaults to http://localhost:5173).
